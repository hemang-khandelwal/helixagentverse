# Copy to .env (git-ignored) and fill in. Never commit real keys.
GEMINI_API_KEY=
# Model IDs: confirm on Google's model page before the hackathon.
GEMINI_MODEL=gemini-4-argon
GEMINI_FAST_MODEL=gemini-3.8-flash
# Free key from https://www.ncbi.nlm.nih.gov/account/ (raises the NCBI rate limit)
NCBI_API_KEY=
# Identify yourself politely to public APIs
CONTACT_EMAIL=
